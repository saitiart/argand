// Interpreter for the expression typed in the UI.
//
// src/expression.ts compiles the formula into postfix instructions and writes
// them into `program`. c_user(z) runs them on a small stack, calling the
// existing complex functions. Every vertex runs the same program, so the
// branches are coherent across the GPU.
//
// Parameters (a, b, ...) are read from `user_params`, a separate buffer, so
// moving a slider only rewrites that array.
//
// The OP_* constants are generated by src/expression.ts and prepended.

const VM_MAX_INSTRUCTIONS: u32 = 256u;
const VM_STACK_SIZE: u32 = 16u;

struct Instruction {
    op: u32,
    arg: u32,       // parameter slot for OP_PARAM
    value: vec2f,   // constant for OP_CONST, real operand for OP_POW_REAL / OP_BESSEL_J
};

struct Program {
    count: u32,
    pad0: u32,
    pad1: u32,
    pad2: u32,
    code: array<Instruction, 256>,
};

@group(0) @binding(2) var<storage, read> program: Program;
@group(0) @binding(3) var<storage, read> user_params: array<vec2f>;

fn c_user(z: vec2f) -> vec2f {
    var stack: array<vec2f, 16>;
    var sp: u32 = 0u;
    let n = min(program.count, VM_MAX_INSTRUCTIONS);

    for (var pc = 0u; pc < n; pc++) {
        let ins = program.code[pc];
        let i = max(sp, 1u) - 1u;          // top of stack
        let x = stack[i];                  // top value (unary / right operand)
        let a = stack[max(i, 1u) - 1u];    // second value (left operand)

        switch (ins.op) {
            // push
            case OP_CONST: { stack[min(sp, VM_STACK_SIZE - 1u)] = ins.value; sp++; }
            case OP_Z:     { stack[min(sp, VM_STACK_SIZE - 1u)] = z; sp++; }
            case OP_T:     { stack[min(sp, VM_STACK_SIZE - 1u)] = vec2f(cp.animationTime, 0.0); sp++; }
            case OP_PARAM: { stack[min(sp, VM_STACK_SIZE - 1u)] = user_params[min(ins.arg, arrayLength(&user_params) - 1u)]; sp++; }

            // binary: a ∘ x → a's slot
            case OP_ADD: { stack[i - 1u] = a + x;          sp--; }
            case OP_SUB: { stack[i - 1u] = a - x;          sp--; }
            case OP_MUL: { stack[i - 1u] = c_mul(a, x);    sp--; }
            case OP_DIV: { stack[i - 1u] = c_div(a, x);    sp--; }
            case OP_POW: { stack[i - 1u] = c_pow(a, x);    sp--; }

            // unary
            case OP_NEG:       { stack[i] = -x; }
            case OP_POW_REAL:  { stack[i] = c_pow_f(x, ins.value.x); }
            case OP_BESSEL_J:  { stack[i] = c_bessel_j(x, ins.value.x); }
            case OP_FACTORIAL: { stack[i] = c_gamma(x + vec2f(1.0, 0.0)); }
            case OP_SIN:   { stack[i] = c_sin(x); }
            case OP_COS:   { stack[i] = c_cos(x); }
            case OP_TAN:   { stack[i] = c_tan(x); }
            case OP_SINH:  { stack[i] = c_sinh(x); }
            case OP_COSH:  { stack[i] = c_cosh(x); }
            case OP_TANH:  { stack[i] = c_tanh(x); }
            case OP_ASIN:  { stack[i] = c_asin(x); }
            case OP_ACOS:  { stack[i] = c_acos(x); }
            case OP_ATAN:  { stack[i] = c_atan(x); }
            case OP_ASINH: { stack[i] = c_asinh(x); }
            case OP_EXP:   { stack[i] = c_exp(x); }
            case OP_LOG:   { stack[i] = c_log(x); }
            case OP_SQRT:  { stack[i] = c_sqrt(x); }
            case OP_INV:   { stack[i] = c_inv(x); }
            case OP_CONJ:  { stack[i] = c_conj(x); }
            case OP_RE:    { stack[i] = c_real(x); }
            case OP_IM:    { stack[i] = c_imag(x); }
            case OP_ABS:   { stack[i] = c_modulus(x); }
            case OP_ARG:   { stack[i] = c_phase(x); }
            case OP_GAMMA: { stack[i] = c_gamma(x); }
            case OP_ZETA:  { stack[i] = c_zeta(x); }
            case OP_XI:    { stack[i] = c_xi(x); }
            case OP_AIRY:  { stack[i] = c_airy(x); }
            default: {}
        }
    }

    return stack[0];
}
